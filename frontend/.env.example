# AERVYN: ECHOES OF TIME - Frontend Environment Configuration Template
# Copy this file to .env or .env.production

# Central Backend API Endpoint
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional: Default Audio Mute State (true/false)
VITE_AUDIO_DEFAULT_MUTED=false

# Optional: Default Graphics Tier (low/medium/high)
VITE_GRAPHICS_DEFAULT_TIER=high
